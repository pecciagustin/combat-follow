VITE_ANTHROPIC_API_KEY=none
VITE_JINA_API_KEY=your_jina_key_here
# Google OAuth Client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client ID, type "Web application")
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Server-side (Vercel functions). Optional: both have safe defaults in lib/serverAuth.js ---
# GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID (used to verify the ID token audience).
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# ADMIN_EMAIL is the account that is auto-approved and sees the admin panel.
# ADMIN_EMAIL=pecciagustin@gmail.com
# Upstash Redis (already configured in Vercel; used to store the user registry + approval status)
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...
